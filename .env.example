# Required for headless first-time login (no saved session yet).
# Copy to .env and fill in your account credentials.
#
# CLI defaults: review on, submit off — pass ./run.sh --submit to post on Shipd.
AUTH_EMAIL=user@example.com

# IMAP app password for the mailbox that receives Clerk verification codes.
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Google account).
# Gmail app passwords contain spaces — keep the value quoted.
AUTH_PASSWORD="your-imap-app-password"

# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993

# Directory where review.py clones submissions via Quick Setup.
# SUBMISSIONS_DIR=./submissions

# After --review, remove the cloned repo and any Docker images/containers
# created by Quick Setup (default: on). Set to 0 to keep artifacts locally.
# CLEANUP_AFTER_REVIEW=1

# Background / overnight orchestrator settings (optional).
# WATCH_INTERVAL_SEC=300
# WATCH_COOLDOWN_EVERY_COMPLETED=5
# WATCH_COOLDOWN_SEC=3600
# PROCESS_NICE=10
# LOG_FILE=./logs/orchestrator.log
# SHIPD_FRESH=1            Clear saved batch resume state on next ./run.sh
# Resume state: logs/watch-batch.json (created automatically during multi-review runs)

# Review agent LLM (orchestrator --review / review_agent.py)
# Easiest: ./run.sh --configure-llm — pick a provider and models and paste the
# API key once (hidden input). The key goes to the OS keychain (macOS Keychain),
# or ~/.config/shipd-agent/credentials (0600) when no keychain is available —
# never into this file. A key env var set here or in your shell wins over a
# stored key; ./run.sh --forget-llm-key removes the stored one.
#
# Provider: anthropic (default) | openai | google | deepseek | moonshot | xai |
# openai-compatible (aliases: claude, gpt, gemini, kimi, grok).
# REVIEW_PROVIDER=anthropic
# Key env var for each provider (only the selected provider's is read):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...          (GOOGLE_API_KEY is also accepted)
# DEEPSEEK_API_KEY=...
# MOONSHOT_API_KEY=...
# XAI_API_KEY=...
# REVIEW_LLM_API_KEY=...      (openai-compatible)
#
# Explore = tool-calling repo pass; finalize (REVIEW_MODEL) = structured verdict.
# Unset or empty = the provider's default (explore / finalize):
#   anthropic  claude-sonnet-4-6 / claude-opus-4-8
#   openai     gpt-6.1-sol / gpt-6.1-sol
#   google     gemini-3.8-flash / gemini-4-argon
#   deepseek   deepseek-flash / deepseek-v4-pro
#   moonshot   kimi-k3.1-pro / kimi-k3.1-pro
#   xai        grok-4.7 / grok-4.7
# A model ID from a different provider (e.g. claude-* with REVIEW_PROVIDER=openai)
# is ignored with a warning.
# REVIEW_EXPLORE_MODEL=claude-sonnet-4-6
# REVIEW_MODEL=claude-opus-4-8
# Required for openai-compatible (gateway / self-hosted /v1 endpoint); for other
# providers it replaces the built-in API base URL.
# REVIEW_LLM_BASE_URL=https://llm-gateway.example.com/v1
# Reasoning effort for openai / google / moonshot (default: low, which keeps
# thinking tokens inside the output budgets below). "default" sends nothing.
# REVIEW_REASONING_EFFORT=low
# Finalize structured-output method override: function_calling | json_schema |
# json_mode (default: chosen per provider).
# REVIEW_STRUCTURED_OUTPUT_METHOD=
# Key store: auto (keychain, else file) | keyring | file
# SHIPD_CREDENTIAL_STORE=auto
REVIEW_PHASE0=full
# Per test.sh invocation timeout in seconds (base/new, with/without solution).
REVIEW_PHASE0_TEST_TIMEOUT=600
# Docker image build timeout for Phase 0 (seconds).
REVIEW_PHASE0_DOCKER_BUILD_TIMEOUT=600
REVIEW_MAX_TOOL_STEPS=15
# After the explore pass, re-prompt the agent to gather evidence for any rubric
# phase it skipped (bounded + only fires when a required phase has no evidence).
# Set to 0 to disable and rely on guardrails only.
# REVIEW_COVERAGE_RECHECK=1
# Extra tool steps allowed for that recheck pass (kept small for cost).
# REVIEW_COVERAGE_RECHECK_MAX_STEPS=6
REVIEW_RUBRIC_MAX_CHARS=16000
# Token / context budgets (lower = cheaper; may reduce review depth).
# REVIEW_TOOL_READ_MAX_CHARS=12000
# REVIEW_PHASE0_LOG_MAX_CHARS=8000
# REVIEW_EXPLORE_TRANSCRIPT_MAX_CHARS=8000
# REVIEW_TOOL_OUTPUT_MAX_CHARS=600
# REVIEW_SCRAPE_PANEL_MAX_CHARS=2500
# REVIEW_FINALIZE_PAYLOAD_MAX_CHARS=32000
# Output caps per LLM call; on reasoning models (GPT, Gemini, Kimi) thinking
# tokens count toward them, so raise these if responses come back truncated.
# REVIEW_EXPLORE_MAX_OUTPUT_TOKENS=4096
# REVIEW_FINALIZE_MAX_OUTPUT_TOKENS=8192
# Keep 0 so phases 1-6 are still reviewed when Phase 0 fails (full feedback).
REVIEW_SKIP_EXPLORE_ON_PHASE0_FAIL=0
REVIEW_DRY_RUN=0
# Effective solution LOC thresholds (substantive added lines in solution.patch).
# Defaults come from review/rubric_defaults.py.
REVIEW_OLYMPUS_MIN_LOC=400
REVIEW_MARS_MIN_LOC=100
REVIEW_MARS_MAX_LOC=600
# Task prompt bars (Phase 1). Shipd allows prompts up to 1,000 words; the
# "Too Many Requirements" estimate flags prompts with more independent
# requirements than this (heuristic — Shipd does not publish its threshold).
# REVIEW_MAX_PROMPT_WORDS=1000
# REVIEW_MAX_PROMPT_REQUIREMENTS=10
